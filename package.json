{
  "files": [
    "dist"
  ],
  "name": "@myco/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "myco": "bin/myco"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && pnpm --filter viewer typecheck",
    "lint": "biome check . && pnpm --filter viewer lint",
    "format": "biome format --write .",
    "schema-validate": "tsx schemas/validate-artifacts.ts",
    "test": "vitest run --exclude test/discovery/s0-live-launcher.test.ts && vitest run --pool=forks --no-file-parallelism test/discovery/s0-live-launcher.test.ts && pnpm schema-validate",
    "test:task": "tsx scripts/myco-test.ts",
    "myco-run": "tsx scripts/myco-run.ts",
    "myco-linux": "tsx scripts/linux-run.ts",
    "myco-gate": "tsx scripts/myco-gate.ts",
    "myco-parallel": "tsx scripts/parallel-run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

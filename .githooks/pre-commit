#!/bin/sh
# TIF-206: refuse to commit anything that looks like a secret.
# Enable once per clone:  git config core.hooksPath .githooks
# Findings are printed REDACTED, so the hook itself never echoes a key.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); secret scan skipped. CI still scans." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose .

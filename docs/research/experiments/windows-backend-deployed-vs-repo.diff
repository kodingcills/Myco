+_SENDKEYS_SPECIAL = set("{}()+%^~[]")
+
+
+def _sendkeys_escape(text):
+    """Escape uiautomation.SendKeys metacharacters so literal text is typed."""
+    return "".join(
+        ("{%s}" % ch) if ch in _SENDKEYS_SPECIAL else ch for ch in str(text)
+    )

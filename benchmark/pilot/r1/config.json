{
  "schema": "myco.pilot.r1-config/1",
  "taskSetVersion": "fc-v1",
  "model": "claude-sonnet-5-5",
  "trials": [
    "fc-v1-001",
    "fc-v1-002",
    "fc-v1-003",
    "fc-v1-004",
    "fc-v1-005",
    "fc-v1-006",
    "fc-v1-007",
    "fc-v1-008",
    "fc-v1-009",
    "fc-v1-010",
    "fc-v1-011",
    "fc-v1-012",
    "fc-v1-013",
    "fc-v1-014",
    "fc-v1-015",
    "fc-v1-016",
    "fc-v1-017",
    "fc-v1-018",
    "fc-v1-061",
    "fc-v1-062",
    "fc-v1-063",
    "fc-v1-071",
    "fc-v1-072",
    "fc-v1-073",
    "fc-v1-081",
    "fc-v1-082",
    "fc-v1-083",
    "fc-v1-091",
    "fc-v1-092",
    "fc-v1-093"
  ],
  "pacing": {
    "concurrency": 1,
    "interTrialDelayS": 90,
    "rateLimitBackoffS": 300,
    "rateLimitBackoffMaxS": 3600,
    "maxConsecutiveRateLimits": 4,
    "trialTimeoutS": 1800,
    "maxAttemptsPerTrial": 3
  },
  "argvTemplate": [
    "-p",
    "{PROMPT}",
    "--model",
    "claude-sonnet-5-5",
    "--output-format",
    "json",
    "--setting-sources",
    "",
    "--strict-mcp-config",
    "--mcp-config",
    "{MCP_CONFIG}",
    "--tools",
    "",
    "--allowedTools",
    "mcp__myco-hcu__screenshot",
    "mcp__myco-hcu__click",
    "mcp__myco-hcu__type_text",
    "mcp__myco-hcu__press_key",
    "mcp__myco-gate__myco_gate_check",
    "--permission-mode",
    "dontAsk",
    "--append-system-prompt",
    "{SYSTEM}"
  ],
  "gateServerTemplate": {
    "command": "node",
    "args": [
      "--import",
      "tsx",
      "{REPO}/scripts/myco-gate.ts",
      "mcp",
      "--no-builtin",
      "--tasks",
      "{TRIAL_DIR}/gate-tasks.json",
      "--task",
      "{TASK_ID}",
      "--run",
      "{RUN_ID}",
      "--evidence-root",
      "{TRIAL_DIR}/gate-evidence"
    ]
  },
  "actuatorServerTemplate": {
    "command": "node",
    "args": [
      "--import",
      "tsx",
      "{REPO}/scripts/myco-hcu.ts",
      "mcp",
      "--hcu-command",
      "C:\\myco\\bin\\computer-use.exe mcp --attach C:\\Users\\myco\\AppData\\Local\\Temp\\hcu--1\\desktop-default.sock"
    ]
  },
  "systemTemplate": "When you believe the task is complete, call mcp__myco-gate__myco_gate_check with taskId \"{TASK_ID}\" and runId \"{RUN_ID}\". End your final message with one line: DONE if you completed the task, NOT DONE otherwise.",
  "childEnvAllowlist": ["HOME", "PATH", "USER", "LOGNAME", "LANG", "TERM", "TMPDIR"]
}
